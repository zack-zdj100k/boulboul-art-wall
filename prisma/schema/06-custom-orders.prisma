// "Créer mon design" requests, quoted manually.

enum CustomOrderStatus {
  PENDING
  REVIEWING
  CONTACTED
  APPROVED
  REJECTED
  DELIVERED
  COMPLETED
}

model CustomOrder {
  id             String            @id @default(cuid())
  reference      String            @unique // BAW-C-2026-000001
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  email          String
  phone          String
  wilayaCode     String?
  wilayaName     String?
  commune        String?
  address        String?
  designMediaId  String?
  designMedia    Media?            @relation(fields: [designMediaId], references: [id], onDelete: SetNull)
  description    String
  widthCm        Int?
  heightCm       Int?
  frameId        String?
  frameName      String?
  extras         Json              @default("[]") // [{ id, name }]
  otherIdea      String?
  notes          String?
  status         CustomOrderStatus @default(PENDING)
  adminNotes     String?
  // Indicative estimate computed at submission from the Sur Mesure settings (null if not configured).
  estimatedPrice Int?
  // Quote set by the admin after review (DZD). `total` is always computed server-side.
  price          Int?
  discountType   PromotionType?
  discountValue  Int?
  deliveryFee    Int?
  total          Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}
