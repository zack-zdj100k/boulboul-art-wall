# Render PostgreSQL: use the "External Database URL" and add ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/boulboul?schema=public&sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/boulboul_test?schema=public"
APP_URL="https://your-domain.dz"
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=""

# Email provider: "smtp" | "resend" | "log" (development only: writes .html files to storage/emails)
EMAIL_PROVIDER="smtp"
# Resend API key (only for EMAIL_PROVIDER=resend)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Boulboul Art Wall <commandes@your-domain.dz>"
# Receives the "new order" notification
ADMIN_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Storage driver: "local" (development only) | "cloudinary" | "s3"
# On Vercel use "cloudinary" (the server disk is read-only).
STORAGE_DRIVER="cloudinary"
STORAGE_LOCAL_DIR="./storage/uploads"
# S3-compatible object storage (AWS S3, Cloudflare R2, Scaleway, MinIO…)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Cloudinary (STORAGE_DRIVER=cloudinary) — Dashboard → "API environment variable"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_FOLDER="boulboul"

# Development seed only
SEED_ADMIN_EMAIL="admin@boulboul.local"
SEED_ADMIN_PASSWORD=""
